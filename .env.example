# ==============================================================================
# FORME DENIM — Environment Variables Reference
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SIDE VARIABLES (Exposed to browser via Vite - Safe for public keys)
# ------------------------------------------------------------------------------
# Your Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Anonymous Key (safe to expose to browser, protected by RLS)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# PayHere Merchant ID (Publicly sent in the payment form to identify your merchant account)
VITE_PAYHERE_MERCHANT_ID=12xxxxx

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE SECRETS (Vercel Serverless Functions ONLY - NEVER prefix with VITE_)
# ------------------------------------------------------------------------------
# Supabase Service Role Key (Bypasses Row Level Security - used ONLY in /api/*)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# PayHere Merchant Secret (Used to generate and verify MD5 payment signatures)
PAYHERE_MERCHANT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
